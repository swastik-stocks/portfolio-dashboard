# Copy this file to .streamlit/secrets.toml (local) and fill in real values.
# On Streamlit Cloud, paste this same structure into your app's Settings -> Secrets
# instead of using this file at all.
# NEVER commit the real secrets.toml -- it's gitignored already.

[auth]
username = "your_chosen_username"
# Generate this hash with: python auth.py "your_actual_password"
password_hash = "paste_the_generated_hash_here"

# Optional -- only needed if deploying to Streamlit Cloud with Turso hosted DB
# [env]
# TURSO_DATABASE_URL = "libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN = "your-turso-auth-token"
# DEEPSEEK_API_KEY = "your-deepseek-key"
